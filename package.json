{
  "name": "ai-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migration:verify": "node scripts/verify-migrations.mjs",
    "migration:test": "node scripts/test-migrations.mjs",
    "validate": "npm run typecheck && npm test && npm run migration:verify && npm run migration:test"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
