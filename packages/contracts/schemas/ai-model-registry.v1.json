{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ai-editor.local/schemas/ai-model-registry.v1.json",
  "title":"AI Editor model/prompt/artifact registry v1",
  "type":"object",
  "oneOf":[{"$ref":"#/$defs/promptEntry"},{"$ref":"#/$defs/modelEntry"},{"$ref":"#/$defs/executionProfile"}],
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},
    "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "version":{"type":"string","minLength":1,"not":{"enum":["latest","main","master","stable","default","current"]}},
    "evidence":{"type":"object","additionalProperties":false,"required":["evidenceId","version"],"properties":{"evidenceId":{"$ref":"#/$defs/nonEmpty"},"version":{"$ref":"#/$defs/version"}}},
    "promptEntry":{"type":"object","additionalProperties":false,"required":["schemaVersion","promptId","promptVersion","purpose","templateArtifactId","templateSha256","inputSchemaVersion","outputSchemaVersion","status","createdAt"],"properties":{"schemaVersion":{"const":"1.0"},"promptId":{"$ref":"#/$defs/nonEmpty"},"promptVersion":{"$ref":"#/$defs/version"},"purpose":{"$ref":"#/$defs/nonEmpty"},"templateArtifactId":{"$ref":"#/$defs/nonEmpty"},"templateSha256":{"$ref":"#/$defs/sha256"},"inputSchemaVersion":{"$ref":"#/$defs/version"},"outputSchemaVersion":{"$ref":"#/$defs/version"},"status":{"enum":["draft","approved","archived"]},"createdAt":{"type":"string","format":"date-time"}}},
    "modelEntry":{"type":"object","additionalProperties":false,"required":["schemaVersion","modelId","modelVersion","role","artifact","compatibility","status","createdAt"],"properties":{"schemaVersion":{"const":"1.0"},"modelId":{"$ref":"#/$defs/nonEmpty"},"modelVersion":{"$ref":"#/$defs/version"},"role":{"enum":["text-generation","vision-language","embedding","reranker","asr","ocr","other"]},"artifact":{"oneOf":[{"$ref":"#/$defs/localArtifact"},{"$ref":"#/$defs/providerArtifact"}]},"compatibility":{"type":"object","additionalProperties":false,"required":["inputSchemaVersion","outputSchemaVersion"],"properties":{"inputSchemaVersion":{"$ref":"#/$defs/version"},"outputSchemaVersion":{"$ref":"#/$defs/version"}}},"status":{"enum":["candidate","approved","retired"]},"createdAt":{"type":"string","format":"date-time"}}},
    "localArtifact":{"type":"object","additionalProperties":false,"required":["deliveryKind","artifactId","artifactSha256","artifactFormat","sourceProvenance","rightsTerms"],"properties":{"deliveryKind":{"const":"local-artifact"},"artifactId":{"$ref":"#/$defs/nonEmpty"},"artifactSha256":{"$ref":"#/$defs/sha256"},"artifactFormat":{"$ref":"#/$defs/nonEmpty"},"sourceProvenance":{"$ref":"#/$defs/evidence"},"rightsTerms":{"$ref":"#/$defs/evidence"}}},
    "providerArtifact":{"type":"object","additionalProperties":false,"required":["deliveryKind","providerId","providerModelRef","termsEvidence"],"properties":{"deliveryKind":{"const":"provider-api"},"providerId":{"$ref":"#/$defs/nonEmpty"},"providerModelRef":{"$ref":"#/$defs/version"},"termsEvidence":{"$ref":"#/$defs/evidence"},"credentialRef":{"$ref":"#/$defs/nonEmpty"}}},
    "executionProfile":{"type":"object","additionalProperties":false,"required":["schemaVersion","profileId","profileVersion","model","decodingPolicyVersion","createdAt"],"properties":{"schemaVersion":{"const":"1.0"},"profileId":{"$ref":"#/$defs/nonEmpty"},"profileVersion":{"$ref":"#/$defs/version"},"model":{"type":"object","additionalProperties":false,"required":["modelId","modelVersion"],"properties":{"modelId":{"$ref":"#/$defs/nonEmpty"},"modelVersion":{"$ref":"#/$defs/version"}}},"prompt":{"type":"object","additionalProperties":false,"required":["promptId","promptVersion"],"properties":{"promptId":{"$ref":"#/$defs/nonEmpty"},"promptVersion":{"$ref":"#/$defs/version"}}},"decodingPolicyVersion":{"$ref":"#/$defs/version"},"scoringPolicyVersion":{"$ref":"#/$defs/version"},"createdAt":{"type":"string","format":"date-time"}}}
  }
}
